{
  "name": "@tenphi/luna",
  "version": "0.1.15",
  "description": "A macOS personal assistant with Apple services, isolated tools, natural conversations, and optional Akno knowledge.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "main": "dist/index.js",
  "bin": {
    "luna": "bin/luna"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.setup.json --noEmit && tsc -p container/agent-runner/tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "setup:auto": "tsx setup/auto.ts",
    "luna": "tsx src/cli/client.ts",
    "chat": "tsx scripts/chat.ts",
    "eval:source-grounding": "tsx scripts/eval-source-grounding.ts",
    "eval:reference-capture": "tsx scripts/eval-reference-capture.ts",
    "eval:topic-boundaries": "tsx scripts/eval-topic-boundaries.ts",
    "eval:public-agent": "tsx scripts/eval-public-agent.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "knip": "knip",
    "knip:production": "knip --production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:container": "cd container/agent-runner && bun test",
    "test:all": "pnpm test && pnpm test:container",
    "check:repository": "node scripts/check-repository-safety.mjs",
    "check:history": "node scripts/check-repository-safety.mjs --history",
    "smoke:package": "node scripts/smoke-package.mjs",
    "docs:dev": "astro dev",
    "docs:doctor": "cookbook doctor",
    "docs:build": "astro build",
    "docs:preview": "astro preview",
    "prepack": "pnpm build && pnpm check:repository",
    "docs:check-build": "cookbook check-build --out site-dist",
    "lock:npm": "node scripts/update-npm-lock.mjs"
  },
  "dependencies": {
    "@chat-adapter/telegram": "4.44.0",
    "@clack/prompts": "1.8.1",
    "@tenphi/akno-client": "0.22.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@onecli-sh/sdk": "0.5.0",
    "better-sqlite3": "13.0.3",
    "chat": "4.44.0",
    "cron-parser": "5.10.4",
    "diff": "9.0.0",
    "imapflow": "1.6.6",
    "kleur": "4.1.5",
    "nodemailer": "10.3.1",
    "zod": "4.6.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "knip": "^6.16.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "@tenphi/cookbook": "0.33.1",
    "astro": "7.4.7"
  },
  "engines": {
    "node": ">=22.22"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://luna.tenphi.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenphi/luna.git"
  },
  "bugs": {
    "url": "https://github.com/tenphi/luna/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin"
  ],
  "files": [
    "bin/",
    "src/",
    "dist/",
    "setup/",
    "scripts/",
    "container/",
    "config/default.jsonc",
    "tsconfig.json",
    "pnpm-workspace.yaml",
    ".nvmrc",
    "THIRD_PARTY_NOTICES.md",
    "!**/*.test.ts",
    "!**/*.map",
    "!**/*.tsbuildinfo",
    "!**/node_modules/**",
    "!**/dist/**",
    "dist/**/*.js",
    "!scripts/eval-*",
    "!scripts/*e2e*",
    "!scripts/*scheduled-report*",
    "!scripts/backfill-*",
    "!scripts/cleanup-sessions.sh",
    "!scripts/q.*",
    "tsconfig.setup.json",
    "npm-shrinkwrap.json"
  ],
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.9",
      "ip-address": "10.7.6",
      "hono": "4.13.17",
      "@hono/node-server": "2.1.6",
      "qs": "6.17.1",
      "proxy-addr": "2.0.8",
      "body-parser": "2.4.0",
      "esbuild": "0.28.2"
    }
  },
  "overrides": {
    "fast-uri": "3.1.9",
    "ip-address": "10.7.6",
    "hono": "4.13.17",
    "@hono/node-server": "2.1.6",
    "qs": "6.17.1",
    "proxy-addr": "2.0.8",
    "body-parser": "2.4.0",
    "esbuild": "0.28.2"
  }
}
