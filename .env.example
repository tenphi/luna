# Secrets only. `luna setup` writes this file for you; settings belong in config/local.jsonc.
# For an npm install the file lives at ~/.luna/.env (or $LUNA_HOME/.env). Never commit it.

# Model endpoint key. Not needed for a keyless local endpoint.
OPENAI_API_KEY=

# Telegram bot token from @BotFather (optional).
TELEGRAM_BOT_TOKEN=

# Web search through Tavily (optional).
TAVILY_API_KEY=

# Gmail app password per configured person, named after their roster key (optional).
# LUNA_MAIL_ADA_APP_PASSWORD=

# Install CJK fonts in the agent image on the next build (optional).
# INSTALL_CJK_FONTS=true
