<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
  <!ELEMENT policymap (policy)*>
  <!ATTLIST policymap xmlns CDATA #FIXED ''>
  <!ELEMENT policy EMPTY>
  <!ATTLIST policy xmlns CDATA #FIXED '' domain NMTOKEN #REQUIRED
    name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKEN #IMPLIED
    stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<!--
  Luna's ImageMagick policy. Overwrites the distro default, which differs
  between ImageMagick 6 and 7 and between Debian suites — owning it explicitly
  beats inheriting whichever one the base image happens to ship.

  Every image the agent touches arrived from a chat message, so it is
  attacker-controlled input. The denials below are deliberate, and each denied
  format has a dedicated non-ImageMagick tool that handles it safely:

    PDF / PS / EPS  ->  pdftoppm -png -r 150   (poppler)
    SVG             ->  rsvg-convert           (librsvg, when installed)
    URLs            ->  curl, then convert the local file
    video           ->  ffmpeg

  If ImageMagick reports "not authorized by the security policy", that is this
  file working as intended, not a broken install.
-->
<policymap>
  <!-- Kills the entire external-program delegate table in one line: ghostscript
       (the CVE-2018-16509 RCE class), curl-as-delegate, ffmpeg-as-delegate. -->
  <policy domain="delegate" rights="none" pattern="*"/>

  <!-- Coders that either shell out or fetch remote data. MSL and MVG are
       scripting formats: an MSL file is a program, not an image. -->
  <policy domain="coder" rights="none" pattern="{PS,PS2,PS3,EPS,PDF,XPS,PCL,MSL,MVG,SVG,URL,HTTP,HTTPS,FTP}"/>
  <policy domain="module" rights="none" pattern="{PS,PDF,XPS}"/>

  <!-- `@file` reads a filename list from disk — an arbitrary-file-read primitive. -->
  <policy domain="path" rights="none" pattern="@*"/>

  <!-- Caps so a decompression bomb (a 100KB PNG declaring 50000x50000) fails
       fast instead of OOM-killing the container out from under the agent. -->
  <policy domain="resource" name="memory" value="512MiB"/>
  <policy domain="resource" name="map" value="1GiB"/>
  <policy domain="resource" name="disk" value="2GiB"/>
  <policy domain="resource" name="width" value="32KP"/>
  <policy domain="resource" name="height" value="32KP"/>
  <policy domain="resource" name="time" value="120"/>
  <policy domain="resource" name="thread" value="2"/>
</policymap>
